# Solo hace falta para un build de producción si el API no está en /api del mismo dominio.
# En desarrollo no se define: Vite redirige /api a http://localhost:8091.
# En Railway se define como variable del servicio; el Dockerfile la recibe al compilar.
# Para un build local, copiar a .env.production con el dominio real del backend.
VITE_API_URL=https://api.dominio-del-sistema/api
